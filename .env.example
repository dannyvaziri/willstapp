NEXT_PUBLIC_SITE_URL=https://[PRODUCTION-DOMAIN]

# disabled | mock | webhook
# Production should use disabled until a real provider is configured.
# mock is allowed only in development.
FORM_PROVIDER=disabled

# Required only when FORM_PROVIDER=webhook.
# Keep this server-side only. Never expose it with NEXT_PUBLIC_.
FORM_WEBHOOK_URL=
FORM_WEBHOOK_SECRET=
